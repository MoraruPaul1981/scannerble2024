<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:id="@+id/relativelayoutshabloni"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TableLayout
        android:shrinkColumns="*"
        android:stretchColumns="*"
        android:collapseColumns="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:background="#FFFFFF"
        android:gravity="top"
        android:theme="@style/Theme.MaterialComponents.Light.NoActionBar">

    <TableRow
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center">
        <!--//TODO ROW 1-->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="70dp"
            app:cardCornerRadius="5dp"
            android:layout_margin="10dp"
            android:padding="5dp"
            android:animateLayoutChanges="true"
            android:gravity="center"
            app:cardBackgroundColor="@color/actionbar_text_color"
            app:strokeColor="@color/icon_dashdornd_tabel2_background"
            app:cardElevation="2dp"
            app:cardMaxElevation="1dp"
            android:translationZ="4dp"
            app:strokeWidth="1dp">
            <RelativeLayout
                android:layout_margin="2dp"
                android:padding="2dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/imageViewСтрелкаВнутриТабеля"
                    android:layout_column="0"
                    android:layout_width="43dp"
                    android:layout_height="55dp"
                    android:backgroundTint="#F1F4F4"
                    android:gravity="center"
                    android:fontFamily="@font/alegreya_sans_sc_thin"
                    android:stateListAnimator="@drawable/icon_back_tabelcustomer_arrow"
                    android:layout_alignParentLeft="true"
                    android:layout_centerVertical="true"
                    android:padding="1dp"
                    android:layout_margin="1dp"
                    android:textAlignment="center"
                    app:cornerRadius="20dp"
                    app:icon="@drawable/icon_back_tabelcustomer_arrow"
                    app:iconGravity="textEnd"
                    app:iconPadding="1dp"
                    app:iconSize="20dp"
                    app:iconTint="#909393"
                    app:rippleColor="#F50057"
                    app:cardCornerRadius="5dp"
                    app:cardElevation="2dp"
                    app:strokeColor="#E0E0E3"
                    app:cardMaxElevation="20dp"
                    app:strokeWidth="1dp"
                    android:translationZ="5dp"
                    tools:ignore="SpeakableTextPresentCheck" />
                <TextView
                    android:id="@+id/textView3СловоТабель"
                    style="@style/Widget.MaterialComponents.MaterialCalendar.DayTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="1dp"
                    android:layout_margin="1dp"
                    android:textAlignment="center"
                    android:layout_centerHorizontal="true"
                    android:layout_centerVertical="true"
                    android:bufferType="normal"
                    android:fontFamily="sans-serif-light"
                    android:foregroundGravity="center"
                    android:gravity="center"
                    android:text="Шаблоны"
                    android:textAllCaps="false"
                    android:textAppearance="@style/TextAppearance.AppCompat.Small"
                    android:textColor="#0E0E0E"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:theme="@style/Theme.AppCompat.DayNight"
                    android:typeface="serif" />

                <TextView
                    android:id="@+id/textviewcountcustomer"
                    style="@style/Widget.MaterialComponents.MaterialCalendar.DayTextView"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:bufferType="normal"
                    android:padding="1dp"
                    android:layout_margin="1dp"
                    android:textAlignment="center"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    android:fontFamily="sans-serif-light"
                    android:foregroundGravity="center"
                    android:gravity="center|fill_horizontal"
                    android:hint="кол:"
                    android:text="кол:"
                    android:textAllCaps="false"
                    android:textAppearance="@style/TextAppearance.AppCompat.Small"
                    android:textColor="#0E0E0E"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:theme="@style/Theme.AppCompat.DayNight"
                    android:typeface="serif" />
            </RelativeLayout>
        </com.google.android.material.card.MaterialCardView>
    </TableRow>






        <TableRow
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center">
            <!--//TODO ROW 1-->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="70dp"
                app:cardCornerRadius="5dp"
                android:layout_margin="10dp"
                android:padding="5dp"
                android:animateLayoutChanges="true"
                android:gravity="center"
                app:cardBackgroundColor="@color/actionbar_text_color"
                app:strokeColor="@color/icon_dashdornd_tabel2_background"
                app:cardElevation="2dp"
                app:cardMaxElevation="1dp"
                android:translationZ="4dp"
                app:strokeWidth="1dp">
                <RelativeLayout
                    android:layout_margin="2dp"
                    android:padding="2dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>
        </TableRow>
</TableLayout>



    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="70dp"
        app:cardCornerRadius="5dp"
        android:layout_margin="5dp"
        android:padding="2dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:animateLayoutChanges="true"
        android:gravity="center"
        app:cardBackgroundColor="@color/actionbar_text_color"
        app:strokeColor="@color/icon_dashdornd_tabel2_background"
        app:cardElevation="2dp"
        app:cardMaxElevation="1dp"
        android:translationZ="4dp"
        app:strokeWidth="1dp">
        <RelativeLayout
            android:layout_margin="2dp"
            android:padding="2dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
           </RelativeLayout>
    </com.google.android.material.card.MaterialCardView>


</RelativeLayout>
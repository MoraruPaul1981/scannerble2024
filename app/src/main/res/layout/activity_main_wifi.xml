<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:foregroundGravity="center"
    android:visibility="visible"
    tools:context=".Settings.View.MainActivity_Settings"
    tools:visibility="visible"
    android:orientation="vertical">



    <com.google.android.material.card.MaterialCardView
        android:id="@+id/materialcardviewrow0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="4dp"
        android:padding="2dp"
        android:animateLayoutChanges="true"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:gravity="center"
        android:translationZ="4dp"
        app:cardBackgroundColor="@color/actionbar_text_color"
        app:cardCornerRadius="5dp"
        app:cardElevation="2dp"
        app:cardMaxElevation="1dp"
        app:strokeColor="@color/icon_dashdornd_tabel2_background"
        app:strokeWidth="1dp">


        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="2dp"
            android:padding="2dp">


            <com.google.android.material.button.MaterialButton
                android:id="@+id/imageViewСтрелкаВнутриНастроек"
                android:layout_width="43dp"
                android:layout_height="55dp"
                android:layout_column="0"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="10dp"
                android:layout_marginTop="5dp"
                android:backgroundTint="#F1F4F4"
                android:fontFamily="@font/alegreya_sans_sc_thin"
                android:gravity="center"
                android:padding="1dp"
                android:stateListAnimator="@drawable/icon_back_tabelcustomer_arrow"
                android:textAlignment="center"
                android:translationZ="5dp"
                app:cardCornerRadius="5dp"
                app:cardElevation="2dp"
                app:cardMaxElevation="20dp"
                app:cornerRadius="20dp"
                app:icon="@drawable/icon_back_tabelcustomer_arrow"
                app:iconGravity="textEnd"
                app:iconPadding="1dp"
                app:iconSize="20dp"
                app:iconTint="#909393"
                app:rippleColor="#F50057"
                app:strokeColor="#E0E0E3"
                app:strokeWidth="1dp"
                tools:ignore="SpeakableTextPresentCheck" />

            <TextView
                android:id="@+id/textView3СловоТабель"
                style="@style/Widget.MaterialComponents.MaterialCalendar.DayTextView"
                android:layout_width="150dp"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_centerVertical="true"
                android:layout_margin="1dp"
                android:bufferType="normal"
                android:fontFamily="sans-serif-light"
                android:foregroundGravity="center"
                android:gravity="center"
                android:padding="1dp"
                android:text="Настройки"
                android:textAlignment="center"
                android:textAllCaps="false"
                android:textAppearance="@style/TextAppearance.AppCompat.Small"
                android:textColor="#0E0E0E"
                android:textSize="18sp"
                android:textStyle="bold"
                android:theme="@style/Theme.AppCompat.DayNight"
                android:typeface="serif" />
        </RelativeLayout>
    </com.google.android.material.card.MaterialCardView>





<ScrollView
    android:layout_width="match_parent"
    android:outlineAmbientShadowColor="@color/divider"
    android:layout_height="500dp">
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/materialcardviewrow1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="4dp"
        android:padding="2dp"
        android:animateLayoutChanges="true"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:gravity="center"
        android:translationZ="4dp"
        app:cardBackgroundColor="@color/actionbar_text_color"
        app:cardCornerRadius="5dp"
        app:cardElevation="2dp"
        app:cardMaxElevation="1dp"
        app:strokeColor="@color/icon_dashdornd_tabel2_background"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="500dp"
            tools:visibility="visible"
            android:background="@color/divider"
            android:orientation="vertical">



    <Switch
        android:id="@+id/switchWIFI"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:layout_marginTop="92dp"
        android:layout_marginEnd="40dp"
        android:checked="true"
        android:hint="режим передача данных "
        android:showText="false"
        android:splitTrack="true"
        android:switchMinWidth="70dp"
        android:text="Только WIFI (Сеть)"
        android:textColorHighlight="#651FFF"
        android:textOff="выкл."
        android:textOn="вкл."
        android:textSize="16sp"
        android:textStyle="normal|bold"
        android:trackTint="#FFD5D9DA"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/СпинерДляСозданииОрганизации"
        tools:checked="true" />

    <Switch
        android:id="@+id/switchАвтоЗаполенияВТАбелеВыходных"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:layout_marginTop="50dp"
        android:layout_marginEnd="40dp"
        android:checked="true"
        android:hint="режим авто заполения Больничных в табеле"
        android:showText="false"
        android:splitTrack="true"
        android:switchMinWidth="70dp"
        android:text="Выкл (Выходные)"
        android:textColorHighlight="#651FFF"
        android:textOff="выкл."
        android:textOn="вкл."
        android:textSize="16sp"
        android:textStyle="normal|bold"
        android:trackTint="#FFD5D9DA"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/switchWIFI"
        tools:checked="true" />

    <Switch
        android:id="@+id/switchСкрытыеПоляПолучениеМатериалов"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:layout_marginTop="50dp"
        android:layout_marginEnd="40dp"
        android:checked="true"
        android:hint="режим авто заполения Больничных в табеле"
        android:showText="false"
        android:splitTrack="true"
        android:switchMinWidth="70dp"
        android:text="Материалы (Скрытые)"
        android:textColorHighlight="#651FFF"
        android:textOff="выкл."
        android:textOn="вкл."
        android:textSize="16sp"
        android:textStyle="normal|bold"
        android:trackTint="#FFD5D9DA"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/switchАвтоЗаполенияВТАбелеВыходных"
        tools:checked="true" />




    <Switch
        android:id="@+id/switchsslcomunications"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:layout_marginTop="50dp"
        android:layout_marginEnd="40dp"
        android:checked="false"
        android:hint="режим подключение защищеное или нет !!!"
        android:showText="false"
        android:splitTrack="true"
        android:switchMinWidth="70dp"
        android:text="Обычный (Сервер)"
        android:textColorHighlight="#651FFF"
        android:textOff="выкл."
        android:textOn="вкл."
        android:textSize="16sp"
        android:textStyle="normal|bold"
        android:trackTint="#FFD5D9DA"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/switchСкрытыеПоляПолучениеМатериалов"
        tools:checked="true" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</ScrollView>



    <ScrollView
        android:layout_width="match_parent"
        android:outlineAmbientShadowColor="@color/divider"
        android:layout_height="150dp">
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/materialcardviewrow3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="4dp"
        android:padding="2dp"
        android:animateLayoutChanges="true"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:gravity="center"
        android:translationZ="4dp"
        app:cardBackgroundColor="@color/divider"
        app:cardCornerRadius="5dp"
        app:cardElevation="2dp"
        app:cardMaxElevation="1dp"
        app:strokeColor="@color/icon_dashdornd_tabel2_background"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="150dp"
            tools:visibility="visible"
            android:orientation="vertical">


            <TextView
                android:id="@+id/textViewВерсияПрограммы"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="50dp"
                android:layout_marginEnd="50dp"
                android:layout_marginBottom="10dp"
                android:fontFamily="sans-serif-condensed-light"
                android:gravity="center_horizontal"
                android:textAlignment="gravity"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textViewТекущийПользователь"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="50dp"
                android:layout_marginEnd="50dp"
                android:layout_marginBottom="5dp"
                android:fontFamily="sans-serif-condensed-light"
                android:gravity="center_horizontal"
                android:textAlignment="gravity"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/textViewВремяПоследнееСинхронизации"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="50dp"
                android:layout_marginEnd="50dp"
                android:layout_marginBottom="5dp"
                android:fontFamily="sans-serif-condensed-light"
                android:gravity="center_horizontal"
                android:textAlignment="gravity"
                android:textStyle="bold" />



            <TextView
                android:id="@+id/textViewРазрабочикПрогрммы"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="50dp"
                android:layout_marginEnd="50dp"
                android:layout_marginBottom="10dp"
                android:fontFamily="sans-serif-condensed-light"
                android:gravity="center_horizontal"
                android:textAlignment="gravity"
                android:textStyle="bold"
                android:text="Собственость: ООО Союз-Автодор"/>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    </ScrollView>



</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/id_card_server_success_data_oncreateviewholder"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="10dp"
    android:animateLayoutChanges="true"
    android:padding="10dp"
    android:textSize="10sp"
    android:theme="@style/Theme.MaterialComponents.DayNight.DarkActionBar"
    app:cardBackgroundColor="#FDFEFE"
    app:cardCornerRadius="5dp"
    app:cardElevation="2dp"
    app:cardMaxElevation="5dp"
    app:strokeColor="#CCD1D1"
    app:strokeWidth="2dp"
    tools:context=".presentationlayer.boot.ActivityServerScanner">


    <TableLayout
        android:id="@+id/tablelayoutgattserver"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF"
        android:gravity="center"
        android:shrinkColumns="*"
        android:stretchColumns="*">


        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_column="0"
            android:layout_margin="1dp"
            android:background="#FFFFFF"
            android:gravity="center_vertical|center_horizontal"
            android:padding="1dp">


            <com.google.android.material.tabs.TabLayout
                android:id="@+id/id_tabLayout_gatt_server_ble"
                android:layout_width="200dp"
                android:layout_height="30dp"
                android:layout_alignParentTop="true"
                android:layout_centerHorizontal="true"
                android:layout_margin="2dp"
                android:elevation="3dp"
                android:padding="2dp"
                app:tabIndicatorColor="#121010"
                app:tabIndicatorHeight="2dp"
                app:tabMinWidth="100dp"
                app:tabMode="fixed"
                app:tabSelectedTextColor="#10100F"
                app:tabTextAppearance="@style/TextAppearance.AppCompat.Caption"
                app:tabTextColor="#050505">

                <com.google.android.material.tabs.TabItem
                    android:id="@+id/id_tabItem_server_ble"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:icon="@drawable/icon_bluetooth_start"
                    android:text="девайс"
                    android:textSize="12sp" />


            </com.google.android.material.tabs.TabLayout>

        </TableRow>





        <!--        //TODO FIO user-->
        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_column="0"
            android:layout_margin="1dp"
            android:background="#FFFFFF"
            android:gravity="center_vertical|center_horizontal"
            android:padding="1dp">
            <!-- //TODO:   id currentROW  -->


            <RelativeLayout
                android:id="@+id/linearLayoutgatt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- //TODO:   FIO   -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/id_textinputlayout_fio"
                    style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox.Dense"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentLeft="true"
                    android:layout_alignParentTop="true"
                    android:layout_margin="2dp"
                    android:focusableInTouchMode="true"
                    app:boxBackgroundMode="outline">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/id_textinputtext_fio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_toLeftOf="@+id/materialbuttonadd_add_fio"
                        android:backgroundTint="#707B7C"
                        android:clickable="false"
                        android:focusable="false"
                        android:gravity="center"
                        android:hint="фио"
                        android:inputType="textCapSentences|textMultiLine"
                        android:minHeight="30dp"
                        android:text="fio value"
                        android:textSize="12sp"
                        android:textStyle="bold">

                    </com.google.android.material.textfield.TextInputEditText>
                </com.google.android.material.textfield.TextInputLayout>


            </RelativeLayout>


        </TableRow>


        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_column="0"
            android:layout_margin="1dp"
            android:background="#FFFFFF"
            android:gravity="center_vertical|center_horizontal"
            android:padding="1dp">
            <!-- //TODO:   id currentROW  -->


            <!-- //TODO:   macdevice  -->

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/id_textinputlayout_macdevice"
                style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox.Dense"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/id_textinputlayout_namedevice"
                android:layout_centerHorizontal="true"
                android:layout_margin="2dp"
                android:clickable="false"
                android:focusable="false"
                android:focusableInTouchMode="true"
                app:boxBackgroundMode="outline">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/id_textinputtext_macdevice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:backgroundTint="#707B7C"
                    android:clickable="false"
                    android:focusable="false"
                    android:gravity="center"
                    android:hint="мак-адрес"
                    android:layout_margin="2dp"
                    android:inputType="textCapSentences|textMultiLine"
                    android:minHeight="30dp"
                    android:text="macdevice value "
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </com.google.android.material.textfield.TextInputLayout>

        </TableRow>


        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_column="0"
            android:layout_margin="1dp"
            android:background="#FFFFFF"
            android:gravity="center_vertical|center_horizontal"
            android:padding="1dp">
            <!-- //TODO:   id currentROW  -->

            <!-- //TODO:   namedevice  -->

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/id_textinputlayout_namedevice"
                style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox.Dense"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/id_textinputlayout_id_currentrow"
                android:layout_centerHorizontal="true"
                android:layout_margin="2dp"
                android:clickable="false"
                android:focusable="false"
                android:focusableInTouchMode="true"
                app:boxBackgroundMode="outline">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/id_textinputtext_namedevice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:backgroundTint="#707B7C"
                    android:clickable="false"
                    android:focusable="false"
                    android:gravity="center"
                    android:hint="девайс"
                    android:layout_margin="2dp"
                    android:inputType="textCapSentences|textMultiLine"
                    android:minHeight="30dp"
                    android:text="namedevice value "
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </com.google.android.material.textfield.TextInputLayout>

        </TableRow>




        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_column="0"
            android:layout_margin="1dp"
            android:background="#FFFFFF"
            android:gravity="center_vertical|center_horizontal"
            android:padding="1dp">
            <!-- //TODO:   id currentROW  -->

            <!-- //TODO:   date_update  -->

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/id_textinputlayout_date_update"
                style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox.Dense"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/id_textinputlayout_completedwork"
                android:layout_centerHorizontal="true"
                android:layout_margin="2dp"
                android:clickable="false"
                android:focusable="false"
                android:focusableInTouchMode="true"
                app:boxBackgroundMode="outline">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/id_textinputtext_date_update"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:backgroundTint="#707B7C"
                    android:clickable="false"
                    android:focusable="false"
                    android:gravity="center"
                    android:hint="дата"
                    android:layout_margin="2dp"
                    android:inputType="textCapSentences|textMultiLine"
                    android:minHeight="30dp"
                    android:text="date_update value "
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </com.google.android.material.textfield.TextInputLayout>


        </TableRow>











    </TableLayout>
</com.google.android.material.card.MaterialCardView>









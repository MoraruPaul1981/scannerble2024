<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/linearistpeoples"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:visibility="visible"
    android:theme="@style/Theme.MaterialComponents.Light.NoActionBar"
    tools:context=".Tabels.Peoples.MainActivity_List_Peoples">


    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cardCornerRadius="3dp"
        app:cardElevation="10dp"
        app:cardMaxElevation="10dp"
        app:strokeWidth="1dp"
        android:translationZ="2dp"
        android:animateLayoutChanges="true"
        app:cardBackgroundColor="@color/divider"
        app:strokeColor="#FFFFFF">



    <TableLayout
        android:shrinkColumns="*"
        android:stretchColumns="0"
        android:collapseColumns="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:gravity="top"
        android:layout_margin="1dp"
        android:padding="1dp"
        android:theme="@style/Theme.MaterialComponents.Light.NoActionBar">

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center">


            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="65dp"
                android:layout_margin="2dp"
                android:animateLayoutChanges="true"
                android:gravity="center"
                android:padding="2dp"
                android:translationZ="4dp"
                app:cardBackgroundColor="@color/actionbar_text_color"
                app:cardCornerRadius="5dp"
                app:cardElevation="2dp"
                app:cardMaxElevation="1dp"
                app:strokeColor="@color/icon_dashdornd_tabel2_background"
                app:strokeWidth="1dp">


                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="2dp"
                    android:padding="2dp">


                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/imageViewСтрелкаВнутриТабеля"
                        android:layout_width="43dp"
                        android:layout_height="55dp"
                        android:layout_column="0"
                        android:layout_alignParentLeft="true"
                        android:layout_centerVertical="true"
                        android:layout_margin="1dp"
                        android:backgroundTint="#F1F4F4"
                        android:fontFamily="@font/alegreya_sans_sc_thin"
                        android:gravity="center"
                        android:padding="1dp"
                        android:stateListAnimator="@drawable/icon_back_tabelcustomer_arrow"
                        android:textAlignment="center"
                        android:translationZ="5dp"
                        app:cardCornerRadius="5dp"
                        app:cardElevation="2dp"
                        app:cardMaxElevation="20dp"
                        app:cornerRadius="20dp"
                        app:icon="@drawable/icon_back_tabelcustomer_arrow"
                        app:iconGravity="textEnd"
                        app:iconPadding="1dp"
                        app:iconSize="20dp"
                        app:iconTint="#909393"
                        app:rippleColor="#F50057"
                        app:strokeColor="#E0E0E3"
                        app:strokeWidth="1dp"
                        tools:ignore="SpeakableTextPresentCheck" />

                    <TextView
                        android:id="@+id/textView3СловоТабель"
                        style="@style/Widget.MaterialComponents.MaterialCalendar.DayTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerHorizontal="true"
                        android:layout_centerVertical="true"
                        android:layout_margin="1dp"
                        android:bufferType="normal"
                        android:fontFamily="sans-serif-light"
                        android:foregroundGravity="center"
                        android:gravity="center"
                        android:padding="1dp"
                        android:text="Сотрудники"
                        android:textAlignment="center"
                        android:textAllCaps="false"
                        android:textAppearance="@style/TextAppearance.AppCompat.Small"
                        android:textColor="#0E0E0E"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:theme="@style/Theme.AppCompat.DayNight"
                        android:typeface="serif" />

                    <TextView
                        android:id="@+id/textviewcountcustomer"
                        style="@style/Widget.MaterialComponents.MaterialCalendar.DayTextView"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"
                        android:layout_margin="1dp"
                        android:bufferType="normal"
                        android:fontFamily="sans-serif-light"
                        android:foregroundGravity="center"
                        android:gravity="center|fill_horizontal"
                        android:hint="кол:"
                        android:padding="1dp"
                        android:text="кол:"
                        android:textAlignment="center"
                        android:textAllCaps="false"
                        android:textAppearance="@style/TextAppearance.AppCompat.Small"
                        android:textColor="#0E0E0E"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:theme="@style/Theme.AppCompat.DayNight"
                        android:typeface="serif" />
                </RelativeLayout>

            </com.google.android.material.card.MaterialCardView>

        </TableRow>





        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">


                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/textviewnamematerial"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:layout_margin="5dp"
                    android:background="@drawable/style_for_assitiionmatrial_create_name2"
                    android:gravity="center_vertical|center_horizontal"
                    android:hint="Дата"
                    android:minWidth="100dp"
                    android:textColorHint="#000000"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:translationZ="1dp"
                    android:visibility="visible"
                    app:cardCornerRadius="5dp"
                    app:cardElevation="1dp" />







                <Spinner
                    android:id="@+id/СпинерТабельМесяц"
                    style="@android:style/Widget.Holo.TextView.SpinnerItem"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_margin="5dp"
                    android:minWidth="250dp"
                    android:padding="2dp"
                    android:spinnerMode="dropdown"
                    android:focusable="false"
                    android:clickable="false"
                    android:layout_below="@+id/textviewnamematerial"
                    android:foregroundGravity="center"
                    android:gravity="center_horizontal"
                    android:background="@drawable/style_forpolymaterialb_cycle_createspinner2"
                    android:layout_centerHorizontal="true"
                    android:layout_centerVertical="true"
                    android:backgroundTintMode="multiply"
                    android:dropDownWidth="match_parent"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </RelativeLayout>
        </TableRow>

































       <!-- //TODO сам лист -->

        <TableRow android:id="@+id/tablerow3"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/materialcardViewrowscroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="5dp"
                    android:layout_above="@+id/materialcardViewlastrow"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="5dp"
                    android:padding="2dp"
                    android:animateLayoutChanges="true"
                    android:gravity="center"
                    app:strokeColor="@color/icon_dashdornd_tabel2_background"
                    app:cardBackgroundColor="@color/actionbar_text_color"
                    app:cardElevation="2dp"
                    android:layout_alignParentTop="true"
                    android:layout_centerHorizontal="true"
                    app:cardMaxElevation="1dp"
                    android:translationZ="4dp"
                    app:strokeWidth="1dp">
            <ScrollView
                android:id="@+id/nestedScrollView_singlet"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:padding="1dp"
                android:fillViewport="true"
                android:scrollbars="horizontal|vertical"
                android:stackFromBottom="true"
                android:transcriptMode="alwaysScroll"
                android:layout_alignParentTop="true"
                android:layout_centerHorizontal="true"
                android:background="@drawable/disayn_line_tablerow5">

                <ListView
                    android:id="@+id/ListAllTabels"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center_horizontal"
                    android:backgroundTintMode="multiply"
                    android:choiceMode="multipleChoice"
                    android:layerType="software"
                    android:divider="@null"
                    android:cacheColorHint="#00000000"
                    android:dividerHeight="0px"
                    android:orientation="vertical"
                    android:scrollbars="horizontal|vertical"
                    android:textAlignment="center"
                    android:textDirection="firstStrong"
                    android:textSize="26dp"
                    android:visibility="visible" />


            </ScrollView>
                </com.google.android.material.card.MaterialCardView>














                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/materialcardViewlastrow"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    app:cardCornerRadius="5dp"
                    android:padding="2dp"
                    android:animateLayoutChanges="true"
                    android:gravity="center"
                    app:cardBackgroundColor="@color/actionbar_text_color"
                    app:strokeColor="@color/icon_dashdornd_tabel2_background"
                    android:layout_alignParentBottom="true"
                    android:layout_centerHorizontal="true"
                    app:cardElevation="2dp"
                    app:cardMaxElevation="1dp"
                    android:translationZ="4dp"
                    app:strokeWidth="1dp">

                 <RelativeLayout
                     android:layout_width="match_parent"
                     android:layout_height="wrap_content">





     <com.google.android.material.textview.MaterialTextView
         android:id="@+id/textviewcfo"
         android:layout_width="100dp"
         android:layout_height="25dp"
         android:background="@drawable/style_for_assitiionmatrial_create_name2"
         android:gravity="center_vertical|center_horizontal"
         android:hint="цфо"
        android:layout_margin="5dp"
         android:padding="2dp"
         android:layout_centerHorizontal="true"
         android:layout_alignParentTop="true"
         android:textColorHint="#000000"
         android:textSize="13sp"
         android:textStyle="bold"
         android:translationZ="1dp"
         android:visibility="visible"
         app:cardCornerRadius="5dp"
         app:cardElevation="1dp" />




     <Spinner
         android:id="@+id/СпинерТабельДепратамент"
         android:layout_width="240dp"
         android:layout_height="40dp"
         android:layout_margin="5dp"
         android:padding="2dp"
         android:background="@drawable/style_forpolymaterialb_cycle_createspinner2"
         android:backgroundTintMode="multiply"
         android:dropDownWidth="match_parent"
         android:foregroundGravity="center"
         android:layout_below="@+id/textviewcfo"
         android:layout_centerHorizontal="true"
         android:gravity="center"
         android:spinnerMode="dropdown"
         android:textColor="@android:color/white"
         android:textSize="9dp"
         android:textStyle="bold"
         android:visibility="visible" />



     <com.google.android.material.floatingactionbutton.FloatingActionButton
         android:id="@+id/floatingactionbuttoncustomers"
         android:layout_width="60dp"
         android:layout_height="60dp"
         android:layout_alignParentRight="true"
         android:layout_margin="5dp"
         android:padding="2dp"
         android:layout_alignRight ="@+id/textviewcfo"
         android:layout_gravity="end|top"
         android:backgroundTintMode="add"
         app:backgroundTint="#FFD5D9DA"
         app:fabSize="normal"
         app:rippleColor="@color/accent"
         android:elevation="10dp"
         android:contentDescription="Подбор"
         app:srcCompat="@drawable/icon_dsu1_plus_tabel" />


 </RelativeLayout>





                </com.google.android.material.card.MaterialCardView>
            </RelativeLayout>
        </TableRow>
    </TableLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>



<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardviewlistpeoples"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="1dp"
    android:padding="1dp"
    app:cardBackgroundColor="#F0F8FF"
    app:cardCornerRadius="5dp"
    app:cardElevation="2dp"
    app:strokeColor="#E0E0E3"
    app:cardMaxElevation="100dp"
    app:strokeWidth="1dp"
    android:translationZ="50dp"
    android:animateLayoutChanges="true"
    android:theme="@style/Theme.MaterialComponents.Light.NoActionBar"
    tools:context=".Tabels.MainActivity_List_Peoples">


    <TableLayout
        android:shrinkColumns="*"
        android:stretchColumns="*"
        android:gravity="center_horizontal|center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">



        <TableRow android:id="@+id/tablerow1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="2dp"
            android:padding="2dp"
            android:gravity="center_vertical|center_horizontal">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="60dp">


                <com.google.android.material.button.MaterialButton
                    android:id="@+id/imageViewСтрелкаВнутриТабеля"
                    android:layout_width="40dp"
                    android:layout_height="50dp"
                    android:layout_margin="5dp"
                    android:padding="2dp"
                    android:layout_column="0"
                    android:layout_alignParentLeft="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="10dp"
                    android:backgroundTint="#F1F4F4"
                    android:gravity="center"
                    android:fontFamily="@font/alegreya_sans_sc_thin"
                    android:stateListAnimator="@drawable/icon_back_tabelcustomer_arrow"
                    android:textAlignment="center"
                    app:cornerRadius="20dp"
                    app:icon="@drawable/icon_back_tabelcustomer_arrow"
                    app:iconGravity="textEnd"
                    app:iconPadding="1dp"
                    app:iconSize="20dp"
                    app:iconTint="#909393"
                    app:rippleColor="#F50057"
                    app:strokeColor="#ABB1B1"
                    app:strokeWidth="1dp"
                    tools:ignore="SpeakableTextPresentCheck" />




                <TextView
                    android:id="@+id/textView3СловоТабель"
                    style="@style/Widget.MaterialComponents.MaterialCalendar.DayTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="50dp"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="10dp"
                    android:bufferType="normal"
                    android:fontFamily="sans-serif-light"
                    android:foregroundGravity="center"
                    android:gravity="center|fill_horizontal"
                    android:text="Сотрудники"
                    android:layout_toEndOf="@+id/imageViewСтрелкаВнутриТабеля"
                    android:layout_toStartOf="@+id/СпинерТабельМесяц"
                    android:padding="2dp"
                    android:textAlignment="center"
                    android:textAllCaps="false"
                    android:textAppearance="@style/TextAppearance.AppCompat.Small"
                    android:textColor="#0E0E0E"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:theme="@style/Theme.AppCompat.DayNight"
                    android:typeface="serif" />



                <Spinner
                    android:id="@+id/СпинерТабельМесяц"
                    style="@android:style/Widget.Holo.Light.Spinner"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="40dp"
                    android:minWidth="150dp"
                    android:layout_margin="5dp"
                    android:padding="2dp"
                    android:layout_marginBottom="2dp"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/style_forpolymaterialb_cycle_createspinner3"
                    android:backgroundTintMode="multiply"
                    android:dropDownWidth="wrap_content"
                    android:foregroundGravity="clip_horizontal"
                    android:gravity="center_horizontal|center_vertical"
                    android:spinnerMode="dropdown"
                    android:textColor="@android:color/white"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:theme="@style/Theme.AppCompat.DayNight.DarkActionBar"
                    android:visibility="visible"
                    tools:visibility="visible" />





            </RelativeLayout>



        </TableRow>



        <TableRow
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:padding="1dp"
            android:background="@color/divider"
            android:gravity="center_vertical|center_horizontal">
        </TableRow>





        <TableRow android:id="@+id/tablerow3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:padding="2dp"
            android:background="@color/accent"
            android:gravity="center_vertical|center_horizontal">
            <ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
                android:layout_width="fill_parent"
                android:layout_height="300dp"
                android:fillViewport="true" >
                <ListView
                    android:id="@+id/ListAllTabels"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginStart="1dp"
                    android:layout_marginTop="1dp"
                    android:layout_marginEnd="1dp"
                    android:layout_marginBottom="1dp"
                    android:backgroundTintMode="multiply"
                    android:choiceMode="multipleChoice"
                    android:layerType="software"
                    android:divider="@null"
                    android:dividerHeight="0dp"
                    android:orientation="vertical"
                    android:layout_margin="5dp"
                    android:scrollbars="horizontal|vertical"
                    android:textAlignment="center"
                    android:textDirection="firstStrong"
                    android:textSize="26dp"
                    android:visibility="visible" />
            </ScrollView>
        </TableRow>




        <TableRow android:id="@+id/tablerow4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="2dp"
            android:padding="2dp"
            android:gravity="center_vertical|center_horizontal">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <Spinner
                    android:id="@+id/СпинерТабельДепратамент"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_margin="10dp"
                    android:layout_alignParentLeft="true"
                    android:layout_centerVertical="true"
                    android:layout_toStartOf="@+id/КруглаяКнопкаСамТабель"
                    android:background="@drawable/style_forpolymaterialb_cycle_createspinner3"
                    android:backgroundTintMode="multiply"
                    android:dropDownWidth="wrap_content"
                    android:foregroundGravity="center"
                    android:gravity="center"
                    android:spinnerMode="dropdown"
                    android:textColor="@android:color/white"
                    android:textSize="9dp"
                    android:textStyle="bold"
                    android:visibility="visible" />

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/КруглаяКнопкаСамТабель"
                    android:layout_width="55dp"
                    android:layout_height="55dp"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    android:layout_gravity="bottom|end"
                     android:layout_margin="10dp"
                    android:backgroundTintMode="add"
                    app:backgroundTint="#FFD5D9DA"
                    app:fabSize="auto"
                    app:srcCompat="@drawable/icon_dsu1_plus_tabel" />
            </RelativeLayout>

        </TableRow>





        <TableRow
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:padding="1dp"
            android:background="@color/divider"
            android:gravity="center_vertical|center_horizontal">
        </TableRow>




    </TableLayout>
</com.google.android.material.card.MaterialCardView>
<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/linearistpeoples"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:theme="@style/Theme.MaterialComponents.Light.NoActionBar"
    tools:context=".Tabels.MainActivity_List_Peoples">



    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardviewlistpeoples"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cardCornerRadius="5dp"
        app:cardElevation="2dp"
        app:cardMaxElevation="10dp"
        app:strokeWidth="1dp"
        android:translationZ="5dp"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:layout_above="@+id/cardviewlistpeoplesdown"
        app:cardBackgroundColor="@color/actionbar_text_color"
        android:animateLayoutChanges="true">


    <TableLayout
        android:shrinkColumns="*"
        android:stretchColumns="*"
        android:gravity="center_horizontal|center_vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/imageViewСтрелкаВнутриТабеля"
                android:layout_width="43dp"
                android:layout_height="55dp"
                android:layout_marginStart="15dp"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="1dp"
                android:padding="2dp"
                android:layout_column="0"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"
                android:layout_alignParentTop="true"
                android:backgroundTint="#F1F4F4"
                android:gravity="center"
                android:fontFamily="@font/alegreya_sans_sc_thin"
                android:stateListAnimator="@drawable/icon_back_tabelcustomer_arrow"
                android:textAlignment="center"
                app:cornerRadius="20dp"
                app:icon="@drawable/icon_back_tabelcustomer_arrow"
                app:iconGravity="textEnd"
                app:iconPadding="1dp"
                app:iconSize="20dp"
                app:iconTint="#909393"
                app:rippleColor="#F50057"
                app:cardCornerRadius="5dp"
                app:cardElevation="2dp"
                app:strokeColor="#E0E0E3"
                app:cardMaxElevation="20dp"
                app:strokeWidth="1dp"
                android:translationZ="5dp"
                tools:ignore="SpeakableTextPresentCheck" />

                <TextView
                    android:id="@+id/textView3СловоТабель"
                    style="@style/Widget.MaterialComponents.MaterialCalendar.DayTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_centerHorizontal="true"
                    android:layout_alignParentTop="true"
                    android:layout_margin="5dp"
                    android:bufferType="normal"
                    android:fontFamily="sans-serif-light"
                    android:foregroundGravity="center"
                    android:gravity="center|fill_horizontal"
                    android:text="Сотрудники"
                    android:padding="2dp"
                    android:textAlignment="center"
                    android:textAllCaps="false"
                    android:textAppearance="@style/TextAppearance.AppCompat.Small"
                    android:textColor="#0E0E0E"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:theme="@style/Theme.AppCompat.DayNight"
                    android:typeface="serif" />
            </RelativeLayout>
        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:padding="1dp"
            android:layout_marginEnd="10dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/style_forpolymaterialb_cycle_createspinner3"
            android:gravity="center_vertical|center_horizontal">
        </TableRow>



        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">


                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/textviewnamematerial"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:layout_margin="5dp"
                    android:background="@drawable/style_for_assitiionmatrial_create_name2"
                    android:gravity="center_vertical|center_horizontal"
                    android:hint="Дата"
                    android:minWidth="100dp"
                    android:textColorHint="#000000"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:translationZ="1dp"
                    android:visibility="visible"
                    app:cardCornerRadius="5dp"
                    app:cardElevation="1dp" />







                <Spinner
                    android:id="@+id/СпинерТабельМесяц"
                    style="@android:style/Widget.Holo.TextView.SpinnerItem"
                    android:layout_width="wrap_content"
                    android:layout_height="45dp"
                    android:layout_margin="5dp"
                    android:minWidth="250dp"
                    android:padding="2dp"
                    android:spinnerMode="dropdown"
                    android:focusable="false"
                    android:clickable="false"
                    android:layout_below="@+id/textviewnamematerial"
                    android:foregroundGravity="center"
                    android:gravity="center_horizontal"
                    android:background="@drawable/style_forpolymaterialb_cycle_createspinner2"
                    android:layout_centerHorizontal="true"
                    android:layout_centerVertical="true"
                    android:backgroundTintMode="multiply"
                    android:dropDownWidth="match_parent"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </RelativeLayout>
        </TableRow>

































       <!-- //TODO сам лист -->

        <TableRow android:id="@+id/tablerow3"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:padding="1dp"
            android:gravity="center_vertical|center_horizontal">

            <ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
                android:layout_width="fill_parent"
                android:layout_height = "fill_parent"
                android:minHeight="450dp"
                android:background="@color/actionbar_text_color"
                android:layout_alignParentBottom="true"
                android:layout_alignParentLeft="true"
                android:layout_alignParentRight="true"
                android:fillViewport="true"
                android:scrollbarSize="4dp"
                >
                <ListView
                    android:id="@+id/ListAllTabels"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center_horizontal"
                    android:padding="5dp"
                    android:layout_margin="5dp"
                    android:backgroundTintMode="multiply"
                    android:choiceMode="multipleChoice"
                    android:layerType="software"
                    android:divider="@null"
                    android:cacheColorHint="#00000000"
                    android:dividerHeight="0px"
                    android:orientation="vertical"
                    android:scrollbars="horizontal|vertical"
                    android:textAlignment="center"
                    android:textDirection="firstStrong"
                    android:textSize="26dp"
                    android:visibility="visible" />
            </ScrollView>
        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:padding="1dp"
            android:layout_marginEnd="10dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/style_forpolymaterialb_cycle_createspinner13"
            android:gravity="center_vertical|center_horizontal">
        </TableRow>



        <TableRow
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:padding="2dp"
            android:gravity="center">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_margin="2dp"
                android:padding="2dp"
                android:layout_height="80dp">




                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/textviewcfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:background="@drawable/style_for_assitiionmatrial_create_name2"
                    android:gravity="center_vertical|center_horizontal"
                    android:hint="цфо"
                    android:layout_margin="2dp"
                    android:minWidth="100dp"
                    android:textColorHint="#000000"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:translationZ="1dp"
                    android:visibility="visible"
                    app:cardCornerRadius="5dp"
                    app:cardElevation="1dp" />










                <Spinner
                    android:id="@+id/СпинерТабельДепратамент"
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    android:layout_margin="5dp"
                    android:padding="1dp"
                    android:layout_below="@+id/textviewcfo"
                    android:layout_alignParentLeft="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/style_forpolymaterialb_cycle_createspinner2"
                    android:layout_toLeftOf="@+id/КруглаяКнопкаСамТабель"
                    android:backgroundTintMode="multiply"
                    android:dropDownWidth="match_parent"
                    android:foregroundGravity="center"
                    android:gravity="center_horizontal"
                    android:spinnerMode="dropdown"
                    android:textColor="@android:color/white"
                    android:textSize="9dp"
                    android:textStyle="bold"
                    android:visibility="visible" />

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/КруглаяКнопкаСамТабель"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    android:layout_gravity="bottom|end"
                    android:padding="2dp"
                    android:layout_margin="10dp"
                    android:backgroundTintMode="add"
                    app:backgroundTint="#FFD5D9DA"
                    app:fabSize="normal"
                    app:srcCompat="@drawable/icon_dsu1_plus_tabel" />
            </RelativeLayout>

        </TableRow>
    </TableLayout>
</com.google.android.material.card.MaterialCardView>


    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardviewlistpeoplesdown"
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        app:cardCornerRadius="10dp"
        android:layout_margin="2dp"
        android:padding="2dp"
        app:cardElevation="10dp"
        app:cardMaxElevation="10dp"
        app:strokeWidth="1dp"
        android:translationZ="5dp"
        android:animateLayoutChanges="true"
        app:cardBackgroundColor="@color/divider"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:theme="@style/Theme.MaterialComponents.Light.NoActionBar">

    </com.google.android.material.card.MaterialCardView>

</RelativeLayout>



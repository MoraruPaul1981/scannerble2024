<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/linearLayout_tabel_single"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:visibility="visible"
    android:theme="@style/Theme.MaterialComponents.Light.NoActionBar"
    tools:context=".Tabels.viewpagers.MainActivity_Tabel_Single_PeopleOneSwipe">
    <TableLayout
        android:id="@+id/tableLayout_headres"
        android:shrinkColumns="*"
        android:stretchColumns="*"
        android:collapseColumns="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:gravity="top"
        android:padding="1dp"
        android:layout_margin="1dp"
        android:theme="@style/Theme.MaterialComponents.Light.NoActionBar"
        tools:context=".Tabels.MainActivity_Tabel_Single_People">



        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:gravity="center"
            android:orientation="vertical"/>





        <!--//TODO   НАЧАЛО ПЕРВАЯ СТРОЧКА ROW #4-->
        <TableRow
            android:id="@+id/tableRow_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_margin="1dp"
            android:padding="1dp"
            android:layout_gravity="center">


            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="5dp"
                android:layout_margin="2dp"
                android:padding="2dp"
                android:animateLayoutChanges="true"
                android:gravity="center"
                app:cardBackgroundColor="@color/actionbar_text_color"
                app:strokeColor="@color/icon_dashdornd_tabel2_background"
                app:cardElevation="2dp"
                app:cardMaxElevation="1dp"
                android:translationZ="4dp"
                app:strokeWidth="1dp">




        <androidx.appcompat.widget.Toolbar
            android:layout_column="0"
            android:id="@+id/toolbar_single"
            android:layout_width="match_parent"
            android:layout_height="25dp"
            android:gravity="center"
            android:layout_margin="1dp"
            android:padding="1dp"
            android:background="#FFFFFF">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/materialTextViewnametabel"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="20dp"
                android:gravity="center"
                android:textStyle="bold"
                android:text="ТАБЕЛЬ"
                android:textColor="#0A0A09"
                android:background="#FFFFFF"
                android:visibility="visible"
                android:textSize="15sp" />

        </androidx.appcompat.widget.Toolbar>



            </com.google.android.material.card.MaterialCardView>


        </TableRow>








        <!--//TODO   НАЧАЛО ПЕРВАЯ СТРОЧКА ROW #4-->
        <TableRow
            android:id="@+id/tableRow_headres"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_margin="1dp"
            android:padding="1dp"
            android:layout_gravity="center_horizontal"
            android:minHeight="50dp">


            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_column="0"
                app:cardCornerRadius="5dp"
                android:layout_margin="2dp"
                android:padding="2dp"
                android:animateLayoutChanges="true"
                android:gravity="center"
                app:cardBackgroundColor="@color/actionbar_text_color"
                app:strokeColor="@color/icon_dashdornd_tabel2_background"
                app:cardElevation="2dp"
                app:cardMaxElevation="1dp"
                android:translationZ="4dp"
                app:strokeWidth="1dp">





                <RelativeLayout
                    android:layout_margin="2dp"
                    android:padding="2dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">


                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/imageButtonbackotsingletabel"
                        android:layout_column="0"
                        android:layout_width="43dp"
                        android:layout_height="55dp"
                        android:backgroundTint="#F1F4F4"
                        android:gravity="center"
                        android:fontFamily="@font/alegreya_sans_sc_thin"
                        android:stateListAnimator="@drawable/icon_dsu1_exit3_foreground"
                        android:layout_alignParentLeft="true"
                        android:layout_centerVertical="true"
                        android:padding="2dp"
                        android:layout_margin="2dp"
                        android:textAlignment="center"
                        app:cornerRadius="20dp"
                        app:icon="@drawable/icon_back_tabelcustomer_arrow"
                        app:iconGravity="textEnd"
                        app:iconPadding="1dp"
                        app:iconSize="20dp"
                        app:cardCornerRadius="5dp"
                        app:cardElevation="2dp"
                        app:strokeColor="#E0E0E3"
                        app:cardMaxElevation="20dp"
                        app:strokeWidth="1dp"
                        android:translationZ="5dp"
                        app:iconTint="#686565"
                        app:rippleColor="#F50057"
                        tools:ignore="SpeakableTextPresentCheck" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/materialTextViewfio"
                        style="@style/Widget.MaterialComponents.MaterialCalendar.DayTextView"
                        android:layout_width="200dp"
                        android:layout_height="wrap_content"
                        android:padding="2dp"
                        android:layout_margin="2dp"
                        android:textAlignment="center"
                        android:layout_centerHorizontal="true"
                        android:layout_alignParentTop="true"
                        android:bufferType="normal"
                        android:fontFamily="sans-serif-light"
                        android:foregroundGravity="center"
                        android:gravity="center"
                        android:hint="ФИО"
                        android:textAllCaps="false"
                        android:textAppearance="@style/TextAppearance.AppCompat.Small"
                        android:textColor="#0E0E0E"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:theme="@style/Theme.AppCompat.DayNight"
                        android:typeface="serif" />



                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/materialTextViewprofession"
                        style="@style/Widget.MaterialComponents.MaterialCalendar.DayTextView"
                        android:layout_width="200dp"
                        android:layout_height="wrap_content"
                        android:padding="2dp"
                        android:layout_margin="2dp"
                        android:textAlignment="center"
                        android:layout_centerHorizontal="true"
                        android:bufferType="normal"
                        android:fontFamily="sans-serif-light"
                        android:foregroundGravity="center"
                        android:layout_below="@id/materialTextViewfio"
                        android:gravity="center"
                        android:hint="Профессия"
                        android:textAllCaps="false"
                        android:textAppearance="@style/TextAppearance.AppCompat.Small"
                        android:textColor="#0E0E0E"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:theme="@style/Theme.AppCompat.DayNight"
                        android:typeface="serif" />












                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/spinnermesazyear_single"
                        style="@style/Widget.MaterialComponents.MaterialCalendar.DayTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="50dp"
                        android:bufferType="normal"
                        android:padding="2dp"
                        android:layout_margin="2dp"
                        android:textAlignment="center"
                        android:layout_alignParentRight="true"
                        android:layout_alignParentTop="true"
                        android:fontFamily="sans-serif-light"
                        android:foregroundGravity="center"
                        android:gravity="center|fill_horizontal"
                        android:hint="месяц"
                        android:textAllCaps="false"
                        android:textAppearance="@style/TextAppearance.AppCompat.Small"
                        android:textColor="#0E0E0E"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:theme="@style/Theme.AppCompat.DayNight"
                        android:typeface="serif" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/spinnerchasy_single"
                        style="@style/Widget.MaterialComponents.MaterialCalendar.DayTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="50dp"
                        android:bufferType="normal"
                        android:padding="2dp"
                        android:layout_margin="2dp"
                        android:textAlignment="center"
                        android:layout_alignParentRight="true"
                        android:layout_below="@id/spinnermesazyear_single"
                        android:fontFamily="sans-serif-light"
                        android:foregroundGravity="center"
                        android:gravity="center|fill_horizontal"
                        android:hint="часы"
                        android:textSize="13sp"
                        android:textAllCaps="false"
                        android:textAppearance="@style/TextAppearance.AppCompat.Small"
                        android:textColor="#0E0E0E"
                        android:textStyle="bold"
                        android:theme="@style/Theme.AppCompat.DayNight"
                        android:typeface="serif" />




                </RelativeLayout>




            </com.google.android.material.card.MaterialCardView>
        </TableRow>


















        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="5dp"
                android:layout_margin="5dp"
                android:padding="2dp"
                android:animateLayoutChanges="true"
                android:gravity="center"
                app:cardBackgroundColor="@color/actionbar_text_color"
                app:strokeColor="@color/icon_dashdornd_tabel2_background"
                app:cardElevation="2dp"
                app:cardMaxElevation="1dp"
                android:translationZ="4dp"
                app:strokeWidth="1dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                    android:layout_height="wrap_content">


            <androidx.core.widget.NestedScrollView
            android:id="@+id/nestedScrollView_singlet"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:layout_alignParentTop="true"
                android:layout_centerHorizontal="true"
                android:layout_above="@+id/cardviewspinnerdepartament"
                android:fitsSystemWindows="true"
                android:scrollbars="vertical"
                android:scrollbarAlwaysDrawVerticalTrack="true"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">


                       <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recycleviewsingletabel"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                     android:layout_alignParentTop="true"
                     android:layout_centerHorizontal="true"
                       android:layout_above="@+id/cardviewspinnerdepartament"
                        android:keyboardNavigationCluster="true"
                        android:scrollbars="vertical"
                        android:visibility="visible"
                        android:windowSoftInputMode="stateVisible|adjustPan"
                        app:layout_behavior="@string/appbar_scrolling_view_behavior"
                        app:layout_optimizationLevel="standard|barrier|chains" />

            </androidx.core.widget.NestedScrollView>


                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardviewspinnerdepartament"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:cardCornerRadius="5dp"
                            android:layout_margin="5dp"
                            android:padding="2dp"
                            android:layout_alignParentBottom="true"
                            android:layout_centerHorizontal="true"
                            android:animateLayoutChanges="true"
                            android:gravity="center"
                            app:cardBackgroundColor="@color/actionbar_text_color"
                            app:strokeColor="@color/icon_dashdornd_tabel2_background"
                            app:cardElevation="2dp"
                            app:cardMaxElevation="1dp"
                            android:translationZ="4dp"
                            app:strokeWidth="1dp">


            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/spinnerdepartament_single"
                android:layout_column="0"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/disayn_line_tablerow5"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"
                android:gravity="center"
                android:padding="2dp"
                android:layout_margin="3dp"
                android:tooltipText="Название цфо" />

                        </com.google.android.material.card.MaterialCardView>

</RelativeLayout>


            </com.google.android.material.card.MaterialCardView>


        </TableRow>
    </TableLayout>
</LinearLayout>